# ════════════════════════════════════════════════════════
#  ZURI — Environment Variables
#  Copy this file to PROJECT ROOT as .env.local and fill in.
#  NEVER commit .env.local to Git.
#  Do NOT put .env.local under src/app/ — Next.js loads from root.
# ════════════════════════════════════════════════════════

# ── APP ─────────────────────────────────────────────────
# Production: https://app.buildzuri.com — must match Supabase Auth Site URL
# or OAuth lands on *.vercel.app and drops the anon onboarding cookie.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Apex marketing site (static deploy) — Home, Pricing, About, Privacy, Terms
NEXT_PUBLIC_MARKETING_URL=https://buildzuri.com
# Production root domain for subdomain routing (docs/02_WEBSITE_BUILDER.md §15)
NEXT_PUBLIC_ROOT_DOMAIN=buildzuri.com
# How live site URLs are formed:
#   subdomain → https://{handle}.buildzuri.com  (production — requires Vercel *.buildzuri.com + DNS CNAME *)
#   path      → {APP_URL}/sites/{handle}         (local / interim before wildcard DNS)
NEXT_PUBLIC_SITE_URL_MODE=subdomain
# Local: NEXT_PUBLIC_SITE_URL_MODE=path and NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# ── SUPABASE ────────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_PROJECT_ID=your_project_ref_id

# ── GEMINI (Website AI only) ────────────────────────────
# From: https://aistudio.google.com/app/apikey (keys usually start with AIza)
# Used for website composition / section regenerate — NOT Content calendar.
# Required unless GEMINI_USE_VERTEX=true
# Keep GEMINI_USE_VERTEX unset or false for AI Studio.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_USE_VERTEX=false
# Model names (override if needed). Google periodically retires model IDs —
# if generation silently falls back to template content, check
# https://ai.google.dev/gemini-api/docs/models for current IDs, or call
# GET https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY
# to list what's actually available to your key.
GEMINI_FLASH_MODEL=gemini-flash-latest
GEMINI_PRO_MODEL=gemini-pro-latest
# Optional Vertex AI backend (needs aiplatform.googleapis.com enabled)
# GEMINI_USE_VERTEX=true
# GOOGLE_APPLICATION_CREDENTIALS=./zuri-service-account.json
# GEMINI_PROJECT_ID=your-gcp-project-id
# GEMINI_LOCATION=us-central1

# ── NVIDIA NIM (Content AI — text + images) ─────────────
# From: https://build.nvidia.com → Get API Key
# Content calendar, captions, series, and FLUX image gen use this key.
# Generated images are stored in Supabase `generated-images` (not Cloudinary).
NVIDIA_API_KEY=your_nvidia_api_key_here
# Optional overrides:
# NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_LLM_FLASH_MODEL=deepseek-ai/deepseek-v4-flash
# NVIDIA_LLM_PRO_MODEL=deepseek-ai/deepseek-v4-pro
# NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-dev


# ── FLUTTERWAVE ─────────────────────────────────────────
# From: Flutterwave Dashboard → Settings → API
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxx
FLW_SECRET_KEY=FLWSECK_TEST-xxxxx
FLW_ENCRYPTION_KEY=xxxxx
FLW_SECRET_HASH=your_webhook_secret_hash
# Plan IDs — canonical: free | pro | growth | premium
FLW_PLAN_PRO_MONTHLY=
FLW_PLAN_GROWTH_MONTHLY=
FLW_PLAN_PREMIUM_MONTHLY=
FLW_PLAN_PRO_ANNUAL=
FLW_PLAN_GROWTH_ANNUAL=
FLW_PLAN_PREMIUM_ANNUAL=

# ── RESEND (Platform Emails) ────────────────────────────
# From: https://resend.com/api-keys
# Domain (buildzuri.com) must be verified in Resend before production send.
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=Zuri <hello@buildzuri.com>
# Reply-To for transactional mail (defaults to support@buildzuri.com in code).
RESEND_REPLY_TO=support@buildzuri.com
# Website/contact emails: "log" (console only) | "send" (Resend).
# Local/dev: keep "log". Production (verified domain): set to "send".
EMAIL_DELIVERY_MODE=log

# ── WEBSITE BUILDER (docs/02_WEBSITE_BUILDER.md §15) ─────
# Curated stock + user-uploaded images are served via Cloudinary (see below).
# Secret for internal generate-website / cron callers.
# Required in production alongside NEXT_PUBLIC_APP_URL so onboarding can
# fire-and-forget website generation. Client fallback exists if unset.
INTERNAL_API_SECRET=your_internal_api_secret_here

# ── CLOUDINARY (Onboarding V2 image infrastructure) ─────
# Cloud name is fixed for this project: dzuvmw4l (see
# docs/00_SESSION_PROMPT_PREMIUM_OVERHAUL.md §5). API key/secret from
# Cloudinary Dashboard → Settings → API Keys.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dzuvmw4l
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ── SECURITY ────────────────────────────────────────────
# Used to encrypt OAuth tokens (platform_connections table)
# Generate: openssl rand -base64 32
ENCRYPTION_SECRET=your_32_byte_base64_secret

# ── FIREBASE CLOUD MESSAGING (web push) ─────────────────
# From Firebase Console → Project settings → Your apps (web) + Cloud Messaging
# Web Push certificate. Service account JSON from Project settings → Service accounts.
# Wrap the JSON in single quotes. Missing keys fail startup in production via
# src/lib/config/validate-env.ts.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'

# ── VERCEL (custom domains — Growth+) ───────────────────
# Create a token at https://vercel.com/account/tokens with domain access.
# Required for POST/DELETE /api/website/custom-domain and verify cron.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
# Optional if the project is under a team
# VERCEL_TEAM_ID=